{
  "version": 2,
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node"
    },
    {
      "src": "public/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/index.js"
    },
    {
      "src": "/(index\\.html)",
      "dest": "/public/$1"
    },
    {
      "src": "/(app\\.html|style\\.css|app\\.js)",
      "dest": "/public/$1"
    }
  ]
}
